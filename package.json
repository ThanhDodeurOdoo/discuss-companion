{
  "name": "discuss-companion",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test",
    "dev": "tauri dev --config app/backend/tauri.conf.json",
    "dev:debug": "RUST_LOG=debug tauri dev --config app/backend/tauri.conf.json",
    "gen:flatbuffers": "npm run build:flatbuffers:ws && npm run build:flatbuffers:ipc",
    "build:flatbuffers:ws": "flatc --rust -o app/backend/src/flatbuffers ws_protocol.fbs && flatc --ts -o extension/src ws_protocol.fbs",
    "build:flatbuffers:ipc": "flatc --rust -o app/backend/src/flatbuffers ipc_protocol.fbs && flatc --ts -o app/frontend/flatbuffers ipc_protocol.fbs",
    "build:app": "tauri build --config app/backend/tauri.conf.json",
    "build:extension": "npm run build:extension:chrome && npm run build:extension:firefox",
    "build:extension:chrome": "TARGET=chrome vite build -c extension/vite.config.ts",
    "build:extension:firefox": "TARGET=firefox vite build -c extension/vite.config.ts",
    "bump": "node scripts/bump-version.mjs",
    "lint": "npm run lint:extension && npm run lint:frontend && npm run lint:backend",
    "typecheck": "npm run typecheck:extension && npm run typecheck:frontend",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "lint:extension": "eslint extension/src --ext .ts",
    "lint:frontend": "eslint app/frontend --ext .ts",
    "lint:backend": "cd app/backend && cargo fmt --check && cargo clippy --tests -- -D warnings",
    "test": "npm run test:frontend && npm run test:extension && npm run test:backend && npm run test:api:ipc && npm run test:api:ws",
    "test:frontend": "node --experimental-vm-modules node_modules/jest/bin/jest.js app/frontend/",
    "test:extension": "node --experimental-vm-modules node_modules/jest/bin/jest.js extension/tests/",
    "test:backend": "cd app/backend && cargo test",
    "test:api:ipc": "cd app/backend && cargo test --test ipc_api_tests",
    "test:api:ws": "cd app/backend && cargo test --test ws_api_tests",
    "format:backend": "cd app/backend && cargo +nightly fmt",
    "pre:dev": "vite",
    "pre:build": "tsc && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@odoo/owl": "file:vendor/owl",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "flatbuffers": "^25.9.23"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/chrome": "^0.1.36",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "~5.5.5",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "~3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
