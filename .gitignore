# Git ignore rules for Discuss Agent App

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/

# Tauri
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
src-tauri/gen/schemas/

# Rust/Cargo
target/

# Dist / Build
dist/
dist-ssr/
out/
!vendor/owl/dist/

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment
.env
*.local
