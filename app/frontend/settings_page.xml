<div class="settings-page">
    <h2 class="settings-title">Settings</h2>
    
    <div class="setting-item">
        <label for="show-symbols" class="setting-label cursor-pointer">
            <span class="prevent-select">Show icons in PTT button</span>
            <span class="setting-desc">Toggle between key names and icons</span>
        </label>
        <input type="checkbox" id="show-symbols" t-model="this.app.showSymbols"/>
    </div>

    <div class="setting-item setting-item--stacked">
        <div class="setting-label">
            <span class="setting-title prevent-select">Appearance</span>
            <span class="setting-desc">Choose a light or dark interface theme</span>
        </div>
        <div class="setting-options setting-options--theme">
            <label
                class="setting-option setting-option--choice"
                t-att-class="{ 'is-selected': this.app.themeMode() === this.app.themeModes.Dark }">
                <input
                    type="radio"
                    name="theme-mode"
                    t-att-checked="this.app.themeMode() === this.app.themeModes.Dark"
                    t-on-change="() => this.app.setThemeMode(this.app.themeModes.Dark)"
                />
                <div class="setting-option__text">
                    <span class="setting-option__label">Dark</span>
                    <span class="setting-option__desc">Low-glare theme for focused call control.</span>
                </div>
            </label>
            <label
                class="setting-option setting-option--choice"
                t-att-class="{ 'is-selected': this.app.themeMode() === this.app.themeModes.Light }">
                <input
                    type="radio"
                    name="theme-mode"
                    t-att-checked="this.app.themeMode() === this.app.themeModes.Light"
                    t-on-change="() => this.app.setThemeMode(this.app.themeModes.Light)"
                />
                <div class="setting-option__text">
                    <span class="setting-option__label">Light</span>
                    <span class="setting-option__desc">Daylight-friendlly theme with higher canvas contrast.</span>
                </div>
            </label>
        </div>
    </div>

    <div class="setting-item setting-item--stacked" t-if="this.app.features()?.callControlsTray">
        <div class="setting-label">
            <span class="setting-title prevent-select">App visibility</span>
            <span class="setting-desc">Choose where the app appears when no window is open</span>
        </div>
        <div class="setting-options">
            <label
                class="setting-option setting-option--choice"
                t-att-class="{ 'is-selected': this.app.appVisibilityMode() === this.app.appVisibilityModes.TrayAndDockWhenWindowOpen }">
                <input
                    type="radio"
                    name="app-visibility-mode"
                    t-att-checked="this.app.appVisibilityMode() === this.app.appVisibilityModes.TrayAndDockWhenWindowOpen"
                    t-on-change="() => this.app.setAppVisibilityMode(this.app.appVisibilityModes.TrayAndDockWhenWindowOpen)"
                />
                <div class="setting-option__text">
                    <span class="setting-option__label">Tray + Dock only when window is open</span>
                    <span class="setting-option__desc">Keep the tray icon; dock icon appears only when the window is open.</span>
                </div>
            </label>
            <label
                class="setting-option setting-option--choice"
                t-att-class="{ 'is-selected': this.app.appVisibilityMode() === this.app.appVisibilityModes.TrayAndDockAlways }">
                <input
                    type="radio"
                    name="app-visibility-mode"
                    t-att-checked="this.app.appVisibilityMode() === this.app.appVisibilityModes.TrayAndDockAlways"
                    t-on-change="() => this.app.setAppVisibilityMode(this.app.appVisibilityModes.TrayAndDockAlways)"
                />
                <div class="setting-option__text">
                    <span class="setting-option__label">Tray + Dock always</span>
                    <span class="setting-option__desc">Show both tray and dock even when the window is closed.</span>
                </div>
            </label>
            <label
                class="setting-option setting-option--choice"
                t-att-class="{ 'is-selected': this.app.appVisibilityMode() === this.app.appVisibilityModes.DockOnly }">
                <input
                    type="radio"
                    name="app-visibility-mode"
                    t-att-checked="this.app.appVisibilityMode() === this.app.appVisibilityModes.DockOnly"
                    t-on-change="() => this.app.setAppVisibilityMode(this.app.appVisibilityModes.DockOnly)"
                />
                <div class="setting-option__text">
                    <span class="setting-option__label">Dock only (no tray icon)</span>
                    <span class="setting-option__desc">Hide the tray icon and keep the dock icon visible.</span>
                </div>
            </label>
        </div>
    </div>

    <div class="setting-item">
        <div class="setting-label">
            <label for="ws-port" class="prevent-select">WebSocket Port</label>
            <span class="setting-desc">Port for extension communication with te extension</span>
        </div>
        <div class="port-control-group">
            <input type="number" id="ws-port" 
                t-model="this.app.wsPort" 
                t-att-disabled="this.app.isWsReloading()"
                min="1024"
                max="65535"
                class="port-input"
            />
            <button class="text-btn std-btn reload-btn prevent-select" 
                t-on-click="() => this.app.reloadWsServer()" 
                t-att-disabled="this.app.isWsReloading()"
                title="Reload WebSocket Server">
                <t t-if="this.app.isWsReloading()">Reloading...</t>
                <t t-else="">Reload</t>
            </button>
        </div>
    </div>

    <div class="setting-item">
        <div class="setting-label">
            <span class="setting-title prevent-select">Event log</span>
            <span class="setting-desc">Clear the activity log shown in the main view</span>
        </div>
        <button
            class="text-btn std-btn settings-action-btn settings-action-btn--danger prevent-select"
            t-on-click="() => this.app.clearLogs()">
            Clear Logs
        </button>
    </div>
</div>
