<templates xml:space="preserve">
    <t t-name="discuss.Root">
        <header class="prevent-select">
            <h1>Discuss Companion</h1>
            <div class="port-control">
                 <label for="ws-port" class="prevent-select">WS Port</label>
                 <input type="number" id="ws-port" 
                    t-att-value="this.app.wsPort()" 
                    t-att-disabled="this.app.isWsReloading()"
                    t-on-change="(ev) => this.app.updatePort(ev)"
                    class="port-input"
                 />
                 <button class="text-btn reload-btn prevent-select" 
                    t-on-click="() => this.app.reloadWsServer()" 
                    t-att-disabled="this.app.isWsReloading()"
                    title="Reload WebSocket Server">
                    <t t-if="this.app.isWsReloading()">Reloading...</t>
                    <t t-else="">Reload</t>
                 </button>
            </div>
            <div class="status-indicators">
                <div class="status-item" t-att-class="this.app.permissionGranted() ? 'granted' : ''" t-att-title="'Whether the accessibility permission is granted'">
                    <div class="status-dot"></div>
                    <span t-out="this.app.permissionGranted() ? 'Accessibility Granted' : 'Permission Required'"/>
                </div>
                <div class="status-item" t-att-class="this.app.extensionConnected() ? 'connected' : ''" t-att-title="'Whether the extension WebSocket is connected'">
                    <div class="status-dot"></div>
                    <span t-out="this.app.extensionConnected() ? 'Ext. Connected' : 'Ext. Disconnected'"/>
                </div>
            </div>
        </header>

        <main>
            <div class="ptt-control prevent-select">
                <button 
                    class="key-display" 
                    t-att-class="{ 'recording': this.app.isRecording(), 'pressed': this.app.isPressed() }" 
                    t-on-click="() => this.app.toggleRecording()">
                    <span t-if="this.app.isRecording()" class="key-text">PRESS ANY KEY...</span>
                    <span t-elif="this.app.showSymbols()" class="key-text" t-out="this.keySymbol()"/>
                    <span t-else="" class="key-text" t-out="this.keyName()"/>
                </button>
            </div>

            <div class="logs-section">
                <div class="logs-header">
                    <h2>Event Logs</h2>
                    <button class="clear-btn prevent-select" t-on-click="() => this.app.clearLogs()">Clear</button>
                </div>
                <div class="logs-container">
                    <t t-foreach="this.app.logs()" t-as="log" t-key="log.id">
                        <div class="log-entry">
                            <span class="log-ts" t-out="log.ts"/>
                            <span t-attf-class="log-type type-{{log.type.toLowerCase()}}" t-out="log.type"/>
                            <span class="log-msg" t-out="log.message"/>
                        </div>
                    </t>
                </div>
            </div>

            <div class="footer-controls">
                <button class="text-btn safety-btn prevent-select" t-on-click="() => this.app.forceRelease()" title="Force stop microphone">
                    force release
                </button>
                <div class="toggle-container">
                    <input type="checkbox" id="show-symbols" t-att-checked="this.app.showSymbols()" t-on-change="(ev) => this.app.showSymbols.set(ev.target.checked)"/>
                    <label for="show-symbols" class="prevent-select">Show icons</label>
                </div>

                <a class="text-btn source-btn" href="https://github.com/ThanhDodeurOdoo/discuss-companion" target="_blank" rel="noreferrer">
                    source
                </a>
            </div>
        </main>
    </t>
</templates>
