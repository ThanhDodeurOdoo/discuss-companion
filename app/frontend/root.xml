<templates xml:space="preserve">
    <t t-name="discuss.Root">
        <header>
            <h1>Discuss Companion</h1>
            <div class="status-indicators">
                <div class="status-item" t-att-class="this.app.permissionGranted() ? 'granted' : ''">
                    <div class="status-dot"></div>
                    <span t-out="this.app.permissionGranted() ? 'Accessibility Granted' : 'Permission Required'"/>
                </div>
                <div class="status-item" t-att-class="this.app.extensionConnected() ? 'connected' : ''">
                    <div class="status-dot"></div>
                    <span t-out="this.app.extensionConnected() ? 'Ext. Connected' : 'Ext. Disconnected'"/>
                </div>
            </div>
        </header>

        <main>
            <div class="ptt-control">
                <div class="key-display" t-att-class="{ 'recording': this.app.isRecording(), 'pressed': this.app.isPressed() }">
                    <span t-out="this.app.isRecording() ? 'PRESS ANY KEY...' : this.keyName()"/>
                </div>
                <button class="action-btn" 
                    t-att-class="this.app.isRecording() ? 'cancel' : ''"
                    t-on-click="() => this.app.toggleRecording()">
                    <t t-out="this.app.isRecording() ? 'Cancel' : 'Change Key'"/>
                </button>
            </div>

            <div class="logs-section">
                <div class="logs-header">
                    <h2>Event Logs</h2>
                    <button class="clear-btn" t-on-click="() => this.app.clearLogs()">Clear</button>
                </div>
                <div class="logs-container">
                    <t t-foreach="this.app.logs()" t-as="log" t-key="log.id">
                        <div class="log-entry">
                            <span class="log-ts" t-out="log.ts"/>
                            <span t-attf-class="log-type type-{{log.type.toLowerCase()}}" t-out="log.type"/>
                            <span class="log-msg" t-out="log.message"/>
                        </div>
                    </t>
                </div>
            </div>

            <div class="footer-controls">
                <button class="text-btn safety-btn" t-on-click="() => this.app.forceRelease()" title="Force stop microphone">
                    force release
                </button>
            </div>
        </main>
    </t>
</templates>
