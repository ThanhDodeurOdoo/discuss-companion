<header class="prevent-select">
    <div class="header-title">
        <h1>Discuss Companion</h1>
        <span
            class="header-connection-indicator"
            t-att-class="this.app.extensionConnected() ? 'is-connected' : 'is-disconnected'"
            t-att-title="this.app.extensionConnected() ? 'Extension connected' : 'Extension disconnected'"
            t-att-aria-label="this.app.extensionConnected() ? 'Extension connected' : 'Extension disconnected'"></span>
    </div>
    <div class="header-controls">
        <div
            t-if="this.app.features()?.ptt &amp;&amp; !this.app.permissionGranted()"
            class="status-item"
            title="Accessibility permission required for push to talk">
            <div class="status-dot"></div>
            <span>Permission Required</span>
            <button class="retry-btn" t-on-click="() => this.app.checkPermission()">
                Retry
            </button>
        </div>
        <div class="view-controls">
             <button
                class="btn btn--icon settings-btn"
                aria-label="Settings"
                title="Settings"
                t-att-class="{ 'active': this.app.showSettings() }"
                t-on-click="() => this.app.toggleSettings()">
                <span class="icon" aria-hidden="true">settings</span>
            </button>
        </div>
    </div>
</header>
