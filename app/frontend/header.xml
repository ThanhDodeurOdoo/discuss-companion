<header class="prevent-select">
    <h1>Discuss Companion</h1>
    <div class="header-controls">
        <div class="status-indicators">
            <div class="status-item" t-att-class="this.app.permissionGranted() ? 'granted' : ''" t-att-title="'Whether the accessibility permission is granted'">
                <div class="status-dot"></div>
                <span t-out="this.app.permissionGranted() ? 'Accessibility Granted' : 'Permission Required'"/>
                <button t-if="!this.app.permissionGranted()" class="retry-btn" t-on-click="() => this.app.checkPermission()">
                    Retry
                </button>
            </div>
            <div class="status-item" t-att-class="this.app.extensionConnected() ? 'connected' : ''" t-att-title="'Whether the extension WebSocket is connected'">
                <div class="status-dot"></div>
                <span t-out="this.app.extensionConnected() ? 'Ext. Connected' : 'Ext. Disconnected'"/>
            </div>
        </div>
        <div class="view-controls">
             <button class="settings-btn" t-att-class="{ 'active': this.app.showSettings() }" t-on-click="() => this.app.toggleSettings()">
                ⚙︎
            </button>
        </div>
    </div>
</header>
