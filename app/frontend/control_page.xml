<div class="ptt-control prevent-select">
    <button 
        class="key-display" 
        t-att-class="{ 'recording': this.app.isRecording(), 'pressed': this.app.isPressed() }" 
        t-on-click="() => this.app.toggleRecording()">
        <span t-if="this.app.isRecording()" class="key-text">PRESS ANY KEY...</span>
        <span t-elif="this.app.showSymbols()" class="key-text" t-out="this.keySymbol()"/>
        <span t-else="" class="key-text" t-out="this.keyName()"/>
    </button>
    <div class="call-panel">
        <div class="call-header">
            <h3>Call Controls</h3>
            <span class="call-status" t-att-class="this.app.callStatusClass()" t-out="this.app.callStatusText()"/>
        </div>
        <div class="call-grid">
            <button
                class="call-btn"
                t-att-class="{ 'is-off': this.app.isMute() }"
                t-att-disabled="!this.app.canUseCallToggles()"
                t-att-title="this.app.isMute() ? 'Unmute' : 'Mute'"
                t-on-click="() => this.app.toggleMute()">
                <span t-out="this.app.isMute() ? 'Unmute' : 'Mute'"/>
            </button>
            <button
                class="call-btn"
                t-att-class="{ 'is-off': this.app.isDeaf() }"
                t-att-disabled="!this.app.canUseCallToggles()"
                t-att-title="this.app.isDeaf() ? 'Undeafen' : 'Deafen'"
                t-on-click="() => this.app.toggleDeafen()">
                <span t-out="this.app.isDeaf() ? 'Undeafen' : 'Deafen'"/>
            </button>
            <button
                class="call-btn"
                t-att-class="{ 'is-on': this.app.isCameraOn() }"
                t-att-disabled="!this.app.canUseCallToggles()"
                t-att-title="this.app.isCameraOn() ? 'Turn camera off' : 'Turn camera on'"
                t-on-click="() => this.app.toggleCamera()">
                <span t-out="this.app.isCameraOn() ? 'Camera off' : 'Camera on'"/>
            </button>
            <button
                class="call-btn"
                t-att-class="{ 'is-on': this.app.isScreenOn() }"
                t-att-disabled="!this.app.canUseCallToggles()"
                t-att-title="this.app.isScreenOn() ? 'Stop sharing screen' : 'Share screen'"
                t-on-click="() => this.app.toggleScreen()">
                <span t-out="this.app.isScreenOn() ? 'Stop share' : 'Share screen'"/>
            </button>
        </div>
        <div class="call-actions">
            <button
                class="std-btn call-action-btn"
                t-att-disabled="!this.app.hasActiveCall()"
                t-on-click="() => this.app.goToCall()">
                Go to Call
            </button>
            <button
                class="std-btn call-action-btn"
                t-att-disabled="!this.app.hasActiveCall()"
                t-on-click="() => this.app.openPip()">
                PiP
            </button>
            <button
                class="std-btn call-action-btn danger"
                t-att-disabled="!this.app.hasActiveCall()"
                t-on-click="() => this.app.leaveCall()">
                Leave
            </button>
        </div>
    </div>
</div>
