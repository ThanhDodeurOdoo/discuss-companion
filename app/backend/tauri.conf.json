{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "discuss-companion",
  "identifier": "com.odoo.discuss-ptt",
  "build": {
    "beforeDevCommand": "npm run pre:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run pre:build",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "discuss-companion",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
