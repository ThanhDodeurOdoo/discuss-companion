<templates>
    <div t-name="Popup" class="popup">
        <t t-if="!this.popup.isSettingsOpen()">
            <div class="call" t-if="this.popup.hasCallTab()">
                <div class="call__pulse" aria-hidden="true"></div>
                <div class="call__actions">
                    <button class="btn btn--icon call__btn" t-att-class="{ 'is-off': this.popup.isMute() }" t-att-title="this.popup.isMute() ? 'Unmute' : 'Mute'" t-on-click="() => this.popup.toggleMicrophone()">
                        <span class="icon" t-if="this.popup.isMute()" aria-hidden="true">mic_off</span>
                        <span class="icon" t-else="" aria-hidden="true">mic</span>
                    </button>
                    <button class="btn btn--icon call__btn" t-att-class="{ 'is-off': this.popup.isDeaf() }" t-att-title="this.popup.isDeaf() ? 'Undeafen' : 'Deafen'" t-on-click="() => this.popup.toggleDeafen()">
                        <span class="icon" t-if="this.popup.isDeaf()" aria-hidden="true">volume_off</span>
                        <span class="icon" t-else="" aria-hidden="true">volume_up</span>
                    </button>
                    <button class="btn btn--icon call__btn" t-att-class="{ 'is-on': this.popup.isCameraOn() }" t-att-title="this.popup.isCameraOn() ? 'Turn camera off' : 'Turn camera on'" t-on-click="() => this.popup.toggleCamera()">
                        <span class="icon" t-if="this.popup.isCameraOn()" aria-hidden="true">videocam</span>
                        <span class="icon" t-else="" aria-hidden="true">videocam_off</span>
                    </button>
                    <button class="btn btn--icon call__btn" t-att-class="{ 'is-on': this.popup.isScreenOn() }" t-att-title="this.popup.isScreenOn() ? 'Stop sharing screen' : 'Share screen'" t-on-click="() => this.popup.toggleScreen()">
                        <span class="icon" t-if="this.popup.isScreenOn()" aria-hidden="true">stop_screen_share</span>
                        <span class="icon" t-else="" aria-hidden="true">screen_share</span>
                    </button>
                    <button class="btn btn--icon btn--danger call__btn" t-att-title="'Leave call'" t-on-click="() => this.popup.leaveCall()">
                        <span class="icon" aria-hidden="true">call_end</span>
                    </button>
                </div>
            </div>
            <div class="actions">
                <button class="btn btn--ghost actions__primary" t-if="this.popup.hasCallTab()" t-on-click="() => this.popup.onClickGoToCall()">Go to Call</button>
                <button class="btn btn--success actions__primary text-truncate" t-if="!this.popup.hasCallTab() &amp;&amp; this.popup.lastJoinedCall()" t-on-click="() => this.popup.rejoinLastCall()" t-att-title="'Re-join ' + this.popup.lastJoinedCall().name">Re-join "<t t-esc="this.popup.lastJoinedCall().name"/>"</button>
                <button class="btn btn--icon btn--ghost actions__settings" t-on-click="() => this.popup.toggleSettings()" t-att-title="'Open settings'">
                    <span class="icon" aria-hidden="true">settings</span>
                </button>
            </div>
        </t>
        <t t-else="">
            <div class="settings__header">
                <div class="settings__title">Settings</div>
                <button class="btn btn--icon btn--ghost" t-on-click="() => this.popup.toggleSettings()" t-att-title="'Close settings'">
                    <span class="icon" aria-hidden="true">close</span>
                </button>
            </div>
            <div class="toggle">
                <label class="toggle__label" for="companion-enabled">Use companion app</label>
                <input class="toggle__input" type="checkbox" id="companion-enabled"
                    t-model="this.popup.isCompanionEnabled"
                    t-on-change="() => this.popup.updateCompanionEnabled()" />
            </div>
            <div class="field" t-if="this.popup.isCompanionEnabled()">
                <label class="field__label" for="port">WebSocket Port</label>
                <div class="field__row">
                    <input class="input" type="number" id="port"
                        t-model="this.popup.port"
                        min="1" max="65535" />
                    <button class="btn btn--primary" id="save" t-on-click="() => this.popup.save()">Save</button>
                </div>
            </div>
            <div class="toggle">
                <label class="toggle__label" for="logging">Logging Enabled</label>
                <input class="toggle__input" type="checkbox" id="logging"
                    t-model="this.popup.isLoggingEnabled"
                    t-on-change="() => this.popup.updateLogging()" />
            </div>
            <div id="status" class="status" t-att-class="{ 'status--default': this.popup.isStatusDefault(), 'status--error': this.popup.isStatusError(), 'status--success': this.popup.isStatusSuccess() }">
                <t t-out="this.popup.statusText()"/>
            </div>
            <div class="settings__actions">
                <button class="btn btn--ghost" t-on-click="() => this.popup.openShortcuts()">
                    <span class="icon" aria-hidden="true">keyboard</span>
                    <span>Shortcuts</span>
                </button>
            </div>
            <div class="info" t-if="this.popup.isOdoo()">
                 <div class="info__title">Odoo detected</div>
                 <div>Server Version: <t t-out="this.popup.serverVersion()"/></div>
                 <div>Owl Version: <t t-out="this.popup.owlVersion()"/></div>
            </div>
        </t>
    </div>
</templates>
