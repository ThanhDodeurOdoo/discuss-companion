{
    "manifest_version": 3,
    "name": "Discuss Companion Bridge",
    "description": "Bridge extension to connect to the Discuss Companion app",
    "version": "0.10.0",
    "homepage_url": "https://github.com/ThanhDodeurOdoo/discuss-companion",
    "permissions": [
        "storage",
        "scripting",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "icons": {
        "128": "assets/icons/inactive_offline_icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "page_bridge.js",
                "content_bundle.js",
                "assets/*.js"
            ],
            "matches": [
                "https://*/*",
                "http://*/*"
            ]
        }
    ],
    "host_permissions": [
        "ws://127.0.0.1/*",
        "http://*/*",
        "https://*/*"
    ],
    "commands": {
        "ptt-pressed": {
            "suggested_key": "Alt+Shift+Y",
            "description": "Push-to-Talk"
        },
        "toggle-voice": {
            "suggested_key": "Alt+Shift+U",
            "description": "Voice Toggle"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*;"
    }

}
