{
    "manifest_version": 3,
    "name": "Discuss Companion Bridge",
    "description": "Bridge extension to connect to the Discuss Companion app",
    "version": "0.1.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "discuss-companion@debug",
            "strict_min_version": "109.0"
        }
    },
    "permissions": [
        "storage",
        "alarms",
        "scripting",
        "activeTab",
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_popup": "options.html"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module"
    },
    "icons": {
        "128": "assets/icons/inactive_offline_icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "externally_connectable": {
        "matches": [
            "<all_urls>"
        ]
    },
    "commands": {
        "ptt-pressed": {
            "description": "Push-to-Talk"
        },
        "toggle-voice": {
            "description": "Voice Toggle"
        }
    },
    "host_permissions": [
        "ws://127.0.0.1/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*;"
    }

}
