{
    "manifest_version": 3,
    "name": "Discuss PTT Agent Extension",
    "description": "Desktop Agent integration for Odoo Discuss Push-to-Talk",
    "version": "1.1.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "discuss-companion@odoo.com",
            "strict_min_version": "109.0"
        }
    },
    "permissions": [
        "storage",
        "alarms"
    ],
    "action": {},
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module"
    },
    "icons": {
        "128": "assets/icons/inactive_offline_icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "externally_connectable": {
        "matches": [
            "<all_urls>"
        ]
    },
    "host_permissions": [
        "ws://127.0.0.1/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:49152;"
    }
}
