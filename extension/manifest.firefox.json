{
    "manifest_version": 3,
    "name": "Discuss Companion Bridge",
    "description": "Bridge extension to connect to the Discuss Companion app",
    "version": "0.13.5",
    "homepage_url": "https://github.com/ThanhDodeurOdoo/discuss-companion",
    "browser_specific_settings": {
        "gecko": {
            "id": "discuss-companion@debug",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "scripts": [
            "service_worker.js"
        ],
        "type": "module"
    },
    "icons": {
        "128": "assets/icons/inactive_offline_icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content_bootstrap.js",
                "page_bridge.js",
                "page_probe.js",
                "content_bundle.js",
                "assets/*.js"
            ],
            "matches": [
                "https://*/*",
                "http://*/*"
            ]
        }
    ],
    "host_permissions": [
        "ws://127.0.0.1/*",
        "http://*/*",
        "https://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*;"
    }

}
