namespace Discuss.IpcProtocol;

enum Modifier : ubyte { Shift, Control, Alt, Meta }

table PttBinding {
  code: ushort;
  modifiers: [Modifier];
}

table SetRecordingMode {
  recording: bool;
}

table SetWsPort {
  port: ushort;
}

// Outgoing events (Backend -> Frontend)

table BackendError {
    message: string;
}

enum ConnectionStatus : ubyte { Connected, Disconnected }

table WsConnection {
    status: ConnectionStatus;
}

table WsMessage {
    message_type: string;
}

table IncomingShutdown {}

union IncomingMessageUnion { IncomingShutdown }

table WsMessageEvent {
    message: IncomingMessageUnion;
}

table PttState {
    is_active: bool;
    code: ushort;
    modifiers: [Modifier];
    is_repeat: bool;
}

table CallState {
    has_call: bool;
    has_state: bool;
    is_mute: bool;
    is_deaf: bool;
    is_camera_on: bool;
    is_screen_on: bool;
}

// Union for all messages sent to frontend
union ToFrontend { 
    BackendError, 
    WsConnection, 
    WsMessageEvent, 
    PttState,
    CallState
}

table ToFrontendMessage {
    event: ToFrontend;
}

root_type ToFrontendMessage;
